{
  "name": "@tsnomad/datastore",
  "version": "0.2.0",
  "description": "Datastore, model and adapter contracts, the TypeScript counterpart to PHPNomad's datastore package",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/tsnomad/datastore#readme",
  "bugs": {
    "url": "https://github.com/tsnomad/datastore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsnomad/datastore.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
